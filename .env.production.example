# Copie este arquivo para ".env" no servidor (docker compose lê ".env" por
# padrão) e preencha os valores reais. Nunca commite o ".env" de verdade.

# --- Banco de dados ---
POSTGRES_USER=labplan
POSTGRES_PASSWORD=troque-por-uma-senha-forte-aqui
POSTGRES_DB=labplan_db
# DATABASE_URL é montada automaticamente pelo docker-compose.prod.yml a partir
# das três variáveis acima — não precisa (e não deve) ser definida aqui.

# --- Autenticação ---
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://seu-dominio.com.br

# --- Admin inicial (criado automaticamente no primeiro start) ---
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_NAME=Administrador
# Deixe em branco para gerar uma senha aleatória (impressa nos logs do
# container "app" na primeira vez — troque-a depois do primeiro login).
SEED_ADMIN_PASSWORD=

# --- Dados de exemplo ---
# NÃO ative em produção — cria 4 perguntas fictícias com anexos de teste
# (inclusive uma foto de exemplo). Deixe de fora ou "false".
SEED_SAMPLE_DATA=false

# --- Domínio (usado pelo Caddy para emitir o certificado HTTPS) ---
DOMAIN=seu-dominio.com.br
